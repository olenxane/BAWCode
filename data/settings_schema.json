{
  "_comment": "设置面板字段声明：TUI /settings 与远控网页设置面板共用的单一来源。system/shortcuts 各为字段数组，新增或调整配置项只需编辑本文件，两端面板同时生效。声明项：key 表单键；path 在 config.json 中的点路径（特殊键仅作说明）；type 取 bool/int/float/str/csv/choice/binding；options 为候选列表或动态源标记（@themes/@modes/@shells/@workflows/@models）；default 缺省值；min/max 数值钳制。",
  "system": [
    {"key": "theme", "path": "ui.theme", "type": "choice", "options": "@themes", "label": "主题", "hint": "←→ 切换主题", "default": "dark"},
    {"key": "mode", "path": "ui.mode", "type": "choice", "options": "@modes", "label": "访问模式", "hint": "confirm/edit/auto/full", "default": "auto"},
    {"key": "logo", "path": "ui.logo", "type": "bool", "label": "会话区Logo", "hint": "←→ 开/关", "default": true},
    {"key": "render_mode", "path": "ui.render_mode", "type": "choice", "options": ["fullscreen", "inline"], "label": "渲染模式", "hint": "fullscreen 全屏会话树 · inline 终端原生滚动与选字，历史只读", "default": "fullscreen"},
    {"key": "font_size", "path": "ui.font_size", "type": "int", "min": 8, "label": "字体大小", "default": 16},
    {"key": "tip_interval", "path": "ui.tip_interval", "type": "float", "min": 0, "label": "提示间隔秒", "default": 5},
    {"key": "retry_times", "path": "llm.retry_times", "type": "int", "min": 0, "label": "LLM重试次数", "default": 3},
    {"key": "retry_delay", "path": "llm.retry_delay", "type": "float", "min": 0, "label": "LLM重试延迟", "default": 1.0},
    {"key": "request_timeout", "path": "llm.request_timeout", "type": "float", "min": 0, "label": "LLM请求超时秒", "hint": "单次请求整体超时（含流式挂起），0=不限时 · 超时自动重试", "default": 180},
    {"key": "scroll_v0", "path": "ui.scroll_v0", "type": "float", "min": 0.1, "label": "滚动v0", "default": 1.0},
    {"key": "scroll_hold_ms", "path": "ui.scroll_hold_ms", "type": "int", "min": 1, "label": "长按阈值ms", "default": 150},
    {"key": "scroll_max_step", "path": "ui.scroll_max_step", "type": "int", "min": 1, "label": "滚动最大步长", "default": 20},
    {"key": "auto_compress", "path": "memory.auto_compress", "type": "bool", "label": "自动压缩上下文", "hint": "←→", "default": true},
    {"key": "compress_threshold", "path": "memory.compress_threshold", "type": "float", "min": 0.05, "max": 1.0, "label": "压缩阈值", "default": 0.8},
    {"key": "compress_keep_recent_tokens", "path": "memory.compress_keep_recent_tokens", "type": "int", "min": 0, "label": "压缩保留尾段token", "default": 16384},
    {"key": "compress_summary_max_tokens", "path": "memory.compress_summary_max_tokens", "type": "int", "min": 100, "label": "摘要上限token", "default": 1024},
    {"key": "tool_whitelist", "path": "context.tool_whitelist", "type": "csv", "label": "工具白名单", "hint": "逗号分隔 · 白名单工具结果跨回合保留", "default": ""},
    {"key": "aggressive_optimization", "path": "context.aggressive_optimization", "type": "bool", "label": "激进上下文优化", "hint": "←→ 开/关 · 回合末按工具类型整理，保留最近12轮调用", "default": false},
    {"key": "mid_turn_keep_thinking_rounds", "path": "context.mid_turn_keep_thinking_rounds", "type": "int", "min": 0, "label": "历史思考保留条数", "hint": "0=关闭 · 每轮请求只带最近N条思考，更旧的仅留档不再发送", "default": 3},
    {"key": "keep_recent_images", "path": "context.keep_recent_images", "type": "int", "min": 0, "label": "保留图片读取张数", "hint": "0=不保护 · 全会话只带最近N张读取的原图，更早的转摘要+路径", "default": 3},
    {"key": "image_max_edge", "path": "context.image_max_edge", "type": "int", "min": 0, "label": "读图缩放长边px", "hint": "0=不缩放 · 读图前等比缩到该长边（需 Pillow）", "default": 1568},
    {"key": "strip_call_args_min_chars", "path": "context.strip_call_args_min_chars", "type": "int", "min": 0, "label": "调用参数压缩阈值", "hint": "0=关闭 · 结果被剥离时，同步压缩长度≥N字符的调用参数（write.content 等）", "default": 512},
    {"key": "max_tool_rounds", "path": "workflow.max_rounds", "type": "int", "min": 0, "label": "最大工具轮数", "hint": "0=用工作流文件值 · 超限后仍有进展会自动续期，不设次数上限", "default": 0},
    {"key": "spin_kill_count", "path": "workflow.spin_kill_count", "type": "int", "min": 1, "label": "空转计数上限", "hint": "重复输出计满即终止回合；未满期间续期不限次", "default": 12},
    {"key": "default_shell", "path": "tools.default_shell", "type": "choice", "options": "@shells", "label": "默认命令执行器", "hint": "←→ 切换", "default": "cmd"},
    {"key": "max_tool_timeout", "path": "tools.max_timeout", "type": "int", "min": 1, "label": "命令超时上限秒", "hint": "execute_command/run_program 传入超时的钳制上限（1-∞）", "default": 1200},
    {"key": "ask_user_timeout", "path": "tools.ask_user_timeout", "type": "bool", "label": "询问自动超时", "hint": "←→ 开/关 · 开启后询问框 5 分钟未选择自动跳过", "default": true},
    {"key": "delete_guard", "path": "security.delete_guard", "type": "bool", "label": "删除安全护栏", "hint": "关闭后 shell 删除命令直接执行；delete_file 始终移入项目回收站", "default": true},
    {"key": "strict_delete_guard", "path": "security.strict_delete_guard", "type": "bool", "label": "严格删除护栏", "hint": "开启时拦截 git clean、find -delete、cmd /c、python -c 删除等无法移入回收站的写法；仅在删除护栏开启时生效", "default": true},
    {"key": "workflow_enabled", "path": "workflow.enabled", "type": "bool", "label": "启用工作流", "hint": "←→ 关=直接对话 · 开=按工作流节点链运行（下一回合生效）", "default": false},
    {"key": "workflow_active", "path": "workflow.active", "type": "choice", "options": "@workflows", "label": "工作流", "hint": "←→ 选择处理管线（仅在启用工作流时生效）"},
    {"key": "log_level", "path": "log.level", "type": "choice", "options": ["debug", "info", "warn", "error", "关闭"], "label": "日志等级", "hint": "←→ 关闭=不记录任何日志（含写盘）", "default": "info"},
    {"key": "active_model_name", "path": "active_model_id", "type": "choice", "options": "@models", "label": "全局默认模型", "hint": "←→ 非工作流主对话与压缩摘要使用"}
  ],
  "shortcuts": [
    {"key": "switch_mode", "path": "ui.switch_mode", "type": "binding", "label": "切换模式", "hint": "Shift+Tab 始终有效；此为额外映射", "options": ["shift+tab", "f2", "f3", "ctrl+g", "ctrl+t", "ctrl+e", "`", "~"], "default": "shift+tab"},
    {"key": "switch_focus", "path": "ui.switch_focus", "type": "binding", "label": "切换焦点", "hint": "会话树 ↔ 输入框", "options": ["tab", "f4", "ctrl+o"], "default": "tab"},
    {"key": "send", "path": "ui.send", "type": "binding", "label": "发送", "hint": "Enter 恒提交；此为额外发送键", "options": ["ctrl+enter", "f5", "ctrl+s"], "default": "ctrl+enter"},
    {"key": "newline", "path": "ui.newline", "type": "binding", "label": "换行", "hint": "默认 Shift+Enter；Enter 不作换行", "options": ["shift+enter", "enter"], "default": "shift+enter"},
    {"key": "complete", "path": "ui.complete", "type": "binding", "label": "命令补全", "hint": "有候选时优先补全", "options": ["tab"], "default": "tab"},
    {"key": "scroll_up", "path": "ui.scroll_up", "type": "binding", "label": "滚动上", "hint": "会话历史向上", "options": ["pageup", "ctrl+up"], "default": "pageup"},
    {"key": "scroll_down", "path": "ui.scroll_down", "type": "binding", "label": "滚动下", "hint": "会话历史向下", "options": ["pagedown", "ctrl+down"], "default": "pagedown"},
    {"key": "expand", "path": "ui.expand", "type": "binding", "label": "树展开", "hint": "焦点在会话树时", "options": ["right", "l"], "default": "right"},
    {"key": "collapse", "path": "ui.collapse", "type": "binding", "label": "树折叠", "hint": "焦点在会话树时", "options": ["left", "h"], "default": "left"},
    {"key": "rollback", "path": "ui.rollback", "type": "binding", "label": "树回退", "hint": "会话树 Ctrl+Z 回退到选中节点；再按取消", "options": ["ctrl+z"], "default": "ctrl+z"}
  ]
}
