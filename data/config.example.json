  },
  "llm": {
    "retry_times": 3,
    "retry_delay": 1.0,
    "stream": true
  },
  "log": {
    "level": "debug",
    "modules": {},
    "console": false,
    "days_to_keep": 14
  },
  "memory": {
    "longterm_path": "data/memory.json",
    "longterm_dir": "data/memory",
    "auto_compress": true,
    "compress_threshold": 0.8,
    "compress_keep_recent_tokens": 16384,
    "compress_summary_max_tokens": 1024,
    "strip_tool_history": true,
    "strip_tool_keep": 6
