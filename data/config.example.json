  "prompt": {
    "dir": "core/prompts",
    "system_files": [
      "system_prompt.md"
    ],
    "plan_files": [
      "plan.md"
    ]
  },
  "system": {
    "font_size": 16
  },
  "ui": {
    "theme": "dark",
    "mode": "auto",
    "logo": true,
    "send": "ctrl+enter",
    "newline": "shift+enter",
    "switch_focus": "tab",
    "switch_mode": "shift+tab",
    "expand": "['right', 'l']",
    "collapse": "['left', 'h']",
    "toggle_fold": [
      "enter",
      "space"
    ],
    "scroll_up": "pageup",
    "scroll_down": "pagedown",
    "complete": "tab",
    "collapse_done_steps": true,
    "scroll_v0": 1.0,
