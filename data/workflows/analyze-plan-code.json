{
  "name": "analyze-plan-code",
  "description": "注入分析提示词 → LLM 分析调研 → 计划（仅高复杂度）→ 编码执行（无测试）",
  "nodes": [
    {
      "id": "system_prompt",
      "type": "system_prompt",
      "files": ["system_prompt.md"]
    },
    {
      "id": "skills",
      "type": "skill",
      "enabled": true,
      "list": []
    },
    {
      "id": "analyze_ctx",
      "type": "llm",
      "prompt_files": ["analyze.md"],
      "capture": "analysis",
      "model_role": "plan"
    },
    {
      "id": "judge",
      "type": "analyze",
      "method": "keywords",
      "keywords_high": ["重构", "架构", "系统", "完整", "多文件", "设计", "实现", "agent", "框架", "迁移"],
      "keywords_low": [],
      "min_len_high": 400,
      "default_level": "low"
    },
    {
      "id": "plan",
      "type": "plan",
      "gate": "complexity == high",
      "confirm": true,
      "steps": true
    },
    {
      "id": "execute",
      "type": "execute",
      "max_rounds": 12,
      "model_role": "code"
    }
  ]
}
