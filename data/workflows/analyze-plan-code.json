{
  "name": "analyze-plan-code",
  "description": "注入分析提示词 → LLM 分析调研 → 计划（仅高复杂度）→ 编码执行（无测试）",
  "nodes": [
    {
      "id": "system_prompt",
      "type": "system_prompt",
      "files": [
        "system_prompt.md"
      ]
    },
    {
      "id": "skills",
      "type": "skill",
      "enabled": true,
      "list": []
    },
    {
      "id": "analyze_ctx",
      "type": "llm",
      "prompt_files": [
        "analyze.md"
      ],
      "capture": "analysis",
      "model_role": "plan"
    },
    {
      "id": "plan",
      "type": "plan",
      "confirm": true,
      "steps": true
    },
    {
      "id": "execute",
      "type": "execute",
      "max_rounds": 12,
      "model_role": "code"
    }
  ]
}
