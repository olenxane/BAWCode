{
  "name": "plan-execute-test",
  "description": "关键词分析 → 计划（仅高复杂度，需确认）→ 编码执行 → 测试验证（不想要哪段就在编辑器里删掉对应节点）",
  "nodes": [
    {
      "id": "system_prompt",
      "type": "system_prompt",
      "files": [
        "system_prompt.md"
      ]
    },
    {
      "id": "skills",
      "type": "skill",
      "enabled": true,
      "list": []
    },
    {
      "id": "plan",
      "type": "plan",
      "confirm": true,
      "steps": true
    },
    {
      "id": "execute",
      "type": "execute",
      "max_rounds": 12,
      "model_role": "code"
    },
    {
      "id": "test",
      "type": "llm",
      "prompt_files": [
        "test.md"
      ],
      "max_rounds": 6,
      "model_role": "review",
      "capture": "test_result"
    }
  ]
}
