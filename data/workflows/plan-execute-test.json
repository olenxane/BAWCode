{
  "name": "plan-execute-test",
  "description": "关键词分析 → 计划（仅高复杂度，需确认）→ 编码执行 → 测试验证（不想要哪段就在编辑器里删掉对应节点）",
  "nodes": [
    {
      "id": "system_prompt",
      "type": "system_prompt",
      "files": ["system_prompt.md"]
    },
    {
      "id": "skills",
      "type": "skill",
      "enabled": true,
      "list": []
    },
    {
      "id": "judge",
      "type": "analyze",
      "method": "keywords",
      "keywords_high": ["重构", "架构", "系统", "完整", "多文件", "设计", "实现", "agent", "框架", "迁移"],
      "keywords_low": [],
      "min_len_high": 400,
      "default_level": "low"
    },
    {
      "id": "plan",
      "type": "plan",
      "gate": "complexity == high",
      "confirm": true,
      "steps": true
    },
    {
      "id": "execute",
      "type": "execute",
      "max_rounds": 12,
      "model_role": "code"
    },
    {
      "id": "test",
      "type": "llm",
      "prompt_files": ["test.md"],
      "max_rounds": 6,
      "model_role": "review",
      "capture": "test_result"
    }
  ]
}
